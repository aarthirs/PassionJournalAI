{
  "name": "reflect-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Reflect AI \u2014 AI mental wellness & personal growth companion (monorepo)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm --workspace client run dev\" \"npm --workspace server run dev\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace client",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "deploy:build": "npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}