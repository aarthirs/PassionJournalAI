PORT=5000
NODE_ENV=development

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# MongoDB connection string (MongoDB Atlas or local).
# Atlas example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/reflect-ai?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/reflect-ai
MONGODB_URI=mongodb://127.0.0.1:27017/reflect-ai

# Redis connection string (OPTIONAL). If omitted, caching is disabled and the
# app serves everything directly from MongoDB.
# Local example:  redis://127.0.0.1:6379
# Upstash example: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
