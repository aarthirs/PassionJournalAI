# ─────────────────────────────────────────────────────────────
# Reflect AI — server environment
# Copy to .env and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Where the frontend runs. Used for OAuth redirects and the CORS allowlist.
CLIENT_URL=http://localhost:5173

# ── AI ──
# Google AI Studio -> Get API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Database (required) ──
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/reflect-ai?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/reflect-ai
# NOTE: if Atlas refuses the connection, add your IP under Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/reflect-ai

# ── Cache (optional) ──
# Leave blank/remove to disable caching entirely — the app serves from MongoDB.
# Local:   redis://127.0.0.1:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ── Auth (required) ──
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# The callback URL must match an Authorized redirect URI exactly.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
