PORT=5000
NODE_ENV=development

# Where the frontend runs. Used for OAuth redirects + CORS.
CLIENT_URL=http://localhost:5173

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/reflect-ai

# Redis (OPTIONAL — caching disabled if unset)
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Secret used to sign JWT access tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Google OAuth 2.0 credentials (from Google Cloud Console -> Credentials).
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Must EXACTLY match an "Authorized redirect URI" in your Google OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
